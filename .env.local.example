# Copiar a .env.local y completar con los valores reales.
#
# Desarrollo local (requiere Docker + `npm run supabase:start`):
# el comando imprime "API URL", "anon key" y "service_role key" — usar esos.
#
# Producción / staging: valores del dashboard de Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para scripts de servidor de confianza (nunca en código expuesto al
# navegador) — RNF1 de Spec.md.
SUPABASE_SERVICE_ROLE_KEY=
